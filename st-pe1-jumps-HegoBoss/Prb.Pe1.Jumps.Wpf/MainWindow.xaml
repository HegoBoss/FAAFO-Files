<Window x:Class="Prb.Pe1.Jumps.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Prb.Pe1.Jumps.Wpf"
        mc:Ignorable="d"
        Title="Verspringen - Persoonlijk Record"
        Height="500" Width="700" Loaded="Window_Loaded">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1"/>
            <RowDefinition Height="32"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="32"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Persoonlijke gegevens -->
        <TextBlock Text="John Doe" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,8" FontSize="14" FontWeight="Bold"/>
        <TextBlock Text="Persoonlijk record (cm):" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,8"/>
        <TextBox x:Name="txtPR" Text="597" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" IsEnabled="False" />
        <Rectangle Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"  Fill="Black"/>
        <!--blanco ruimte op row 3-->

        <!-- Invoer prestatie-->

        <TextBlock Text="Sprong 1 (cm):" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,8"/>
        <TextBox x:Name="txtJump1" Grid.Row="4" Grid.Column="1" Margin="0,0,0,8" />

        <TextBlock Text="Sprong 2 (cm):" Grid.Row="5" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,8"/>
        <TextBox x:Name="txtJump2" Grid.Row="5" Grid.Column="1" Margin="0,0,0,8" />

        <TextBlock Text="Sprong 3 (cm):" Grid.Row="6" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,8"/>
        <TextBox x:Name="txtJump3" Grid.Row="6" Grid.Column="1" Margin="0,0,0,8" />

        <!--blanco ruimte op row 7-->

        <!-- Knoppen -->
        <Button x:Name="btnShowStats"  Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2" Content="Verwerk prestatie" Width="150" Margin="0,0,8,0" HorizontalAlignment="Center" Click="BtnShowStats_Click"/>

        <!--blanco ruimte op row 9-->

        <!-- Uitvoer in afzonderlijke grid -->
        <Grid x:Name="grdStats" Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="80"/>
                <RowDefinition Height="32"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="200"/>
            </Grid.ColumnDefinitions>

            <!-- Stats -->

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Beste sprong (cm):"  VerticalAlignment="Center" Margin="0,0,8,0"/>
            <Label x:Name="lblBestJump" Grid.Row="0" Grid.Column="1" Margin="0,0,0,0" Content="-"/>

            <TextBlock Text="Gemiddelde sprong (cm):" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,8" Height="auto"/>
            <Label x:Name="lblAverageJump" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" Content="-"/>
            <Label x:Name="lblMessage" Grid.Row="2" Grid.Column="0"  Grid.ColumnSpan="2" VerticalAlignment="Stretch" BorderBrush="#FF9D9D9D" BorderThickness="1" Margin="0, 0, 0, 0"/>

            <!--blanco ruimte-->

            <!-- Knop Save -->
            <Button x:Name="btnNewPerformance" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Content="Nieuwe prestatie" Width="150"  HorizontalAlignment="Center" Click="BtnNewPerformance_Click"/>
        </Grid>

        <!-- Geschiedenis -->
        <Grid x:Name="grdHistory" Grid.Row="0" Grid.Column="3" Grid.RowSpan="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
               Text="Historiek prestaties" Margin="16,0,8,0" HorizontalAlignment="Left"/>
            <ListBox Grid.Row="1" x:Name="lstHistory" Margin="16,0,0,0" VerticalAlignment="Stretch"/>
        </Grid>
        
    </Grid>
</Window>
