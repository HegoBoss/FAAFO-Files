<Window x:Class="Pra.Freezer.Keeper.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Pra.Freezer.Keeper.Wpf"
        mc:Ignorable="d"
        Title="Freezer" Height="300" Width="650" Loaded="Window_Loaded">
    <Grid>
        <Image Source="resources/magnifying-glass.png" Height="20" HorizontalAlignment="Left" VerticalAlignment="top" Margin="230, 12, 10, 10"/>
        <Image x:Name="imgClearFilter" Source="resources/clear-filter.png" Height="20"  HorizontalAlignment="Left" VerticalAlignment="Top" Margin="258,13,0,0" MouseLeftButtonDown="imgClearFilter_MouseLeftButtonDown"/>
        <TextBox x:Name="txtFilter" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10, 10, 10, 10" Width="100" Height="25" TextChanged="txtFilter_TextChanged" />
        <DatePicker x:Name="dtpFilter" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="115, 10, 10, 10" Width="110" Height="25" SelectedDateChanged="dtpFilter_SelectedDateChanged" />
        <ListBox x:Name="lstProducts" HorizontalAlignment="Left" VerticalAlignment="Stretch" Margin="10, 40, 10, 10" Width="285" SelectionChanged="lstProducts_SelectionChanged" />
        <Button x:Name="btnUseProduct" Content="Gebruik product" IsEnabled="False" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0, 12, 20, 0" Click="btnUseProduct_Click" />
        <GroupBox x:Name="grpProductDetails" IsEnabled="false" Header="Gegevens product" HorizontalAlignment="Stretch" Margin="300,30,10,10">
            <Grid>
                <Label Content="Naam:" Margin="10"/>
                <TextBox x:Name="txtName" Width="190" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="110, 15, 0, 0"/>
                <Label Content="Bewaartijd:" Margin="10, 40, 10, 10"/>
                <TextBox x:Name="txtMaxStorage" Width="35" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="110,44,0,0"/>
                <Label Content="maanden" Width="60" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="153,40,0,0"/>
                <Label Content="Invriesdatum:" Margin="10, 70, 10, 10"/>
                <DatePicker x:Name="dtpFreezerDate" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="110, 72, 0, 0"/>
                <Label Content="Hoeveelheid:" Margin="10, 100, 10, 10"/>
                <TextBox x:Name="txtQuantity" Width="35" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="110, 105, 15, 0"/>
                <Button x:Name="btnSave" Visibility="Hidden" Content="Bewaren" HorizontalAlignment="Left" VerticalAlignment="top" Margin="15, 135, 0, 10" Padding="5" Click="btnSave_Click"  />
                <Button x:Name="btnCancel" Visibility="Hidden" Content="Annuleren" HorizontalAlignment="Left" VerticalAlignment="top" Margin="80, 135, 0, 10" Padding="5" Click="btnCancel_Click"  />
            </Grid>
        </GroupBox>
        <Button x:Name="btnAddProduct" Content="Vries product in" VerticalAlignment="Top" Margin="0,11,118,0" Height="20" Background="#FF8DE8F9" HorizontalAlignment="Right" Width="90" Click="btnAddProduct_Click" />
    </Grid>
</Window>
