         
               <Window x:Class="PE2.CycleRentApp.Prb.MainWindow"
     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
     xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
     xmlns:local="clr-namespace:PE2.CycleRentApp.Prb"
     mc:Ignorable="d"
     Title="🚴🏿‍CycleRentApp" Height="550" Width="800" Loaded="Window_Loaded">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Standplaatsen met label boven de radiobuttons -->
                        <StackPanel Orientation="Vertical" Grid.Row="0" Margin="0,0,0,10">
                            <Label Content="Kies standplaats" FontWeight="Bold"/>
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="rdb0" Content="Standplaats Brugge" GroupName="Stations" Margin="5"/>
                                <RadioButton x:Name="rdb1" Content="Standplaats Kortrijk" GroupName="Stations" Margin="5"/>
                                <RadioButton x:Name="rbd2" Content="Standplaats Gent" GroupName="Stations" Margin="5"/>
                                <RadioButton x:Name="rbd3" Content="Standplaats Brussel" GroupName="Stations" Margin="5"/>
                                <RadioButton x:Name="rbd4" Content="Standplaats Leuven" GroupName="Stations" Margin="5"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Categorieën -->
                        <StackPanel x:Name="stpCategory" Orientation="Vertical" Grid.Row="1" Margin="0,0,0,10" IsEnabled="False">
                            <Label Content="Kies een categorie" FontWeight="Bold"/>
                            <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="0,0,0,10">
                                <Button x:Name="btnBikes" Content="Fietsen" Margin="5"/>
                                <Button x:Name="btnKids" Content="Kinderfietsen" Margin="5"/>
                                <Button x:Name="btnAcc" Content="Accessoires" Margin="5"/>
                                <Button x:Name="btnExtra" Content="Extra’s" Margin="5"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Bestelling -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <ComboBox x:Name="cmbProducts" Margin="5" Visibility="Hidden"/>
                                <StackPanel Orientation="Horizontal" Margin="5">
                                    <Button x:Name="btnAdd" Content="+" Width="40" Margin="5"/>
                                    <Button x:Name="btnRemove" Content="-" Width="40" Margin="5"/>
                                </StackPanel>
                                <Button x:Name="btnClear" Content="Leeg Standplaats" Margin="5" IsEnabled="False"/>
                                <Button x:Name="btnTicket" Content="Maak Ticket" Margin="5" IsEnabled="False"/>
                                <Button x:Name="btnShowHistory" Content="Toon Historiek" Margin="5" Background="Aquamarine" IsEnabled="False"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="Bestelling:" FontWeight="Bold"/>
                                <ListBox x:Name="lstOrder" Height="250"/>
                                <TextBlock x:Name="tbkTotal" FontSize="16" FontWeight="Bold" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- Status -->
                        <TextBlock Grid.Row="3" Text="CycleRent Fietsverhuur App" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                    </Grid>



        </Window>


